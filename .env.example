# Copiar este archivo a .env antes de levantar el proyecto:
#   cp .env.example .env
# .env esta excluido de git (ver .gitignore) - nunca commitear credenciales reales.
# Los valores por defecto aqui son solo para desarrollo local, no para produccion.

# --- Base de datos PostgreSQL ---
DB_NAME=inventario
DB_USER=inventario
DB_PASSWORD=changeme_local_dev_only
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080

# --- JWT (Spring Security + JWT + RBAC, ver docs/adr/ADR-005-jwt-rbac.md) ---
# El valor de abajo es SOLO para desarrollo local. Generar uno propio y unico
# por entorno real (minimo 32 caracteres) con, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-please-override-with-JWT_SECRET-env-var-2026
# 1 hora en milisegundos. Sin revocacion ni refresh token en este alcance.
JWT_EXPIRATION_MS=3600000

# Origenes autorizados a llamar a la API desde un navegador (CORS). Debe
# incluir la URL desde la que se sirve el frontend; sin esto el navegador
# bloquea el login. Varios origenes se separan por coma.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
# URL base que el frontend usa para llamar a la API (se fija en tiempo de
# build del contenedor, ver frontend/Dockerfile).
VITE_API_BASE_URL=http://localhost:8080/api/v1
