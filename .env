# Copiar este archivo a .env antes de levantar el proyecto:
#   cp .env.example .env
# .env esta excluido de git (ver .gitignore) - nunca commitear credenciales reales.
# Los valores por defecto aqui son solo para desarrollo local, no para produccion.

# --- Base de datos PostgreSQL ---
DB_NAME=inventario
DB_USER=inventario
DB_PASSWORD=changeme_local_dev_only
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080

# --- Frontend ---
FRONTEND_PORT=3000
# URL base que el frontend usa para llamar a la API (se fija en tiempo de
# build del contenedor, ver frontend/Dockerfile).
VITE_API_BASE_URL=http://localhost:8080/api/v1
